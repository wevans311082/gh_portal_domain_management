# Django
DJANGO_SECRET_KEY=your-very-long-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.46,www.cyberask.co.uk,portal.cyberask.co.uk,domains.cyberask.co.uk,billing.cyberask.co.uk,cyberask.co.uk

# Startup automation (container entrypoint)
AUTO_MAKEMIGRATIONS=0
RUN_STARTUP_MIGRATIONS=1
MIGRATION_LEADER=1
MIGRATION_LOCK_ID=8453201
RUN_COLLECTSTATIC=1

# Database (compose defaults use grumpy_* for volume compatibility)
DATABASE_URL=postgres://grumpy:grumpy_pass@db:5432/grumpy_portal

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@cyberask.co.uk
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Cyber Ask Domains <noreply@cyberask.co.uk>

# Stripe (optional — cart can checkout to invoice without live payments)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# GoCardless
GOCARDLESS_ACCESS_TOKEN=your-gocardless-token
GOCARDLESS_ENVIRONMENT=sandbox

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# WHM/cPanel
WHM_HOST=your-whm-host.example.com
WHM_PORT=2087
WHM_USERNAME=root
WHM_API_TOKEN=your-whm-api-token
# Nameservers used when registering/transferring domains (comma-separated).
# If empty, the platform tries WHM nameserver config / ns1|ns2.<apex> from WHM hostname.
WHM_NAMESERVERS=ns1.example.com,ns2.example.com

# ResellerClub (domains)
# Live API base URL: https://httpapi.com/api
# Test API base URL: https://test.httpapi.com/api
RESELLERCLUB_RESELLER_ID=your-reseller-id
RESELLERCLUB_CUSTOMER_ID=your-customer-id
RESELLERCLUB_API_KEY=your-api-key
RESELLERCLUB_API_URL=https://test.httpapi.com/api
RESELLERCLUB_DEBUG_MODE=false

# Cloudflare
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_EMAIL=your-cloudflare-email

# Companies House
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Sentry (optional)
SENTRY_DSN=

# Backup
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Site
SITE_DOMAIN=www.cyberask.co.uk
SITE_NAME=Cyber Ask Domains

# Cookies — leave empty for a single host (domains.cyberask.co.uk).
# Set both to .cyberask.co.uk only if portal/billing/domains share one login.
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
CSRF_TRUSTED_ORIGINS=http://10.0.0.46,http://localhost,http://127.0.0.1,https://www.cyberask.co.uk,https://portal.cyberask.co.uk,https://domains.cyberask.co.uk,https://billing.cyberask.co.uk
